{
  "info": {
    "name": "РБПО Лаба4 — театр",
    "description": "Выполнить всю коллекцию через Run. Учебный вход администратора: admin / admin. По умолчанию используется Basic ADMIN; в запросах покупателя выбран Basic USER. Первый запрос получает CSRF-токен, Postman сохраняет cookie автоматически. Покупатели, даты и id создаются при запуске; в конце свои записи удаляются. Если пароль изменён, укажите новый в переменной adminPassword.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {"type": "basic", "basic": [{"key": "username", "value": "{{adminLogin}}", "type": "string"}, {"key": "password", "value": "{{adminPassword}}", "type": "string"}]},
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8083"},
    {"key": "adminLogin", "value": "admin"},
    {"key": "adminPassword", "value": "admin"},
    {"key": "userLogin", "value": ""},
    {"key": "userPassword", "value": ""}
  ],
  "item": [
    {
      "name": "1. Регистрация, вход, CSRF и роли",
      "item": [
        {
          "name": "01. Получить CSRF-токен и подготовить временные данные",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/csrf",
            "auth": {"type": "noauth"}
          },
          "event": [
            {"listen": "prerequest", "script": {"exec": [
              "const метка = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
              "pm.collectionVariables.set(\"userLogin\", \"buyer_\" + метка);",
              "pm.collectionVariables.set(\"userPassword\", \"Lab4_\" + метка + \"aA9\");",
              "pm.collectionVariables.set(\"otherLogin\", \"other_\" + метка);",
              "const день = 24 * 60 * 60 * 1000;",
              "pm.collectionVariables.set(\"futureStart\", new Date(Date.now() + 7 * день).toISOString().slice(0, 19));",
              "pm.collectionVariables.set(\"pastStart\", new Date(Date.now() - 2 * день).toISOString().slice(0, 19));"
            ]}},
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Токен получен\", () => pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty);",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);"
            ]}}
          ]
        },
        {
          "name": "02. Без входа каталог недоступен",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/plays",
            "auth": {"type": "noauth"}
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 401\", () => pm.response.to.have.status(401));"
            ]}}
          ]
        },
        {
          "name": "03. Регистрация без CSRF запрещена",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {"type": "noauth"},
            "body": {"mode": "raw", "raw": "{\"имя\": \"Проверка: покупатель\", \"логин\": \"{{userLogin}}\", \"пароль\": \"{{userPassword}}\"}"},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 403\", () => pm.response.to.have.status(403));"
            ]}}
          ]
        },
        {
          "name": "04. Слабый пароль не принимается",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {"type": "noauth"},
            "body": {"mode": "raw", "raw": "{\"имя\": \"Проверка: покупатель\", \"логин\": \"{{userLogin}}\", \"пароль\": \"123\"}"},
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-TOKEN", "value": "{{csrfToken}}"}]
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 400\", () => pm.response.to.have.status(400));"
            ]}}
          ]
        },
        {
          "name": "05. При регистрации нельзя назначить себе ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {"type": "noauth"},
            "body": {"mode": "raw", "raw": "{\"имя\": \"Проверка: покупатель\", \"логин\": \"{{userLogin}}\", \"пароль\": \"{{userPassword}}\", \"роль\": \"ADMIN\"}"},
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-TOKEN", "value": "{{csrfToken}}"}]
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 400\", () => pm.response.to.have.status(400));"
            ]}}
          ]
        },
        {
          "name": "06. Зарегистрировать покупателя",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {"type": "noauth"},
            "body": {"mode": "raw", "raw": "{\"имя\": \"Проверка: покупатель\", \"логин\": \"{{userLogin}}\", \"пароль\": \"{{userPassword}}\"}"},
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-TOKEN", "value": "{{csrfToken}}"}]
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"userId\", pm.response.json().id);",
              "pm.test(\"роль\", () => pm.expect(pm.response.json().роль).to.equal(\"USER\"));",
              "pm.test(\"активен\", () => pm.expect(pm.response.json().активен).to.equal(true));"
            ]}}
          ]
        },
        {
          "name": "07. Повторная регистрация с тем же логином запрещена",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {"type": "noauth"},
            "body": {"mode": "raw", "raw": "{\"имя\": \"Проверка: покупатель\", \"логин\": \"{{userLogin}}\", \"пароль\": \"{{userPassword}}\"}"},
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-TOKEN", "value": "{{csrfToken}}"}]
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 409\", () => pm.response.to.have.status(409));"
            ]}}
          ]
        },
        {
          "name": "08. Покупатель видит свой профиль без пароля",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {"type": "basic", "basic": [{"key": "username", "value": "{{userLogin}}", "type": "string"}, {"key": "password", "value": "{{userPassword}}", "type": "string"}]}
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"роль\", () => pm.expect(pm.response.json().роль).to.equal(\"USER\"));",
              "pm.test(\"Пароля нет в ответе\", () => pm.expect(pm.response.text().includes(\"пароль\")).to.equal(false));"
            ]}}
          ]
        },
        {
          "name": "09. Вход с неверным паролем запрещён",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {"type": "basic", "basic": [{"key": "username", "value": "{{userLogin}}", "type": "string"}, {"key": "password", "value": "IncorrectPassword9A", "type": "string"}]}
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 401\", () => pm.response.to.have.status(401));"
            ]}}
          ]
        },
        {
          "name": "10. Покупателю недоступен список пользователей",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users",
            "auth": {"type": "basic", "basic": [{"key": "username", "value": "{{userLogin}}", "type": "string"}, {"key": "password", "value": "{{userPassword}}", "type": "string"}]}
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 403\", () => pm.response.to.have.status(403));"
            ]}}
          ]
        },
        {
          "name": "11. Администратор блокирует покупателя",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "body": {"mode": "raw", "raw": "{\"активен\": false}"},
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-TOKEN", "value": "{{csrfToken}}"}]
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"активен\", () => pm.expect(pm.response.json().активен).to.equal(false));"
            ]}}
          ]
        },
        {
          "name": "12. Заблокированный покупатель не может войти",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {"type": "basic", "basic": [{"key": "username", "value": "{{userLogin}}", "type": "string"}, {"key": "password", "value": "{{userPassword}}", "type": "string"}]}
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 401\", () => pm.response.to.have.status(401));"
            ]}}
          ]
        },
        {
          "name": "13. Администратор снимает блокировку",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "body": {"mode": "raw", "raw": "{\"активен\": true}"},
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-TOKEN", "value": "{{csrfToken}}"}]
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"активен\", () => pm.expect(pm.response.json().активен).to.equal(true));"
            ]}}
          ]
        }
      ]
    },
    {
      "name": "2. ADMIN меняет каталог, USER читает и бронирует",
      "item": [
